PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
VERIFIER_MODE=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ATTESTATION_MIN_CONFIDENCE=0.72
MAX_DELIVERABLE_CHARS=20000

# Optional GitHub API token for commit and file-tree verification.
GITHUB_TOKEN=
# Optional stable Ed25519 PEM signing key; blank uses an ephemeral mock-TEE key per process.
# This is a software signature for the demo, not hardware-backed TEE evidence.
TEE_SIGNING_PRIVATE_KEY_PEM=
# On-chain writes are off until an operator explicitly enables them.
ATTESTOR_ALLOW_ONCHAIN_WRITES=false
# Required bearer token whenever ATTESTOR_ALLOW_ONCHAIN_WRITES=true.
ATTESTOR_API_TOKEN=
# Optional 1Click API partner key. Never expose this value to the browser.
NEAR_INTENTS_API_KEY=
# NEAR mainnet account used for source-chain refunds (NEAR-origin assets only).
NEAR_INTENTS_REFUND_ADDRESS=proofpay.near
# Dry quotes are safe by default. Fundable quote responses require explicit opt-in.
INTENTS_ALLOW_FUNDABLE_QUOTES=false
INTENTS_SLIPPAGE_BPS=100
# 0 means no application-specific ceiling; on-chain criterion may set a lower limit.
ATTESTOR_MAX_BUDGET_YOCTO=0

# Optional NEAR verifier key tooling. Never use a Full-Access key as the agent key.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ACCOUNT_ID=proofpay.testnet
NEAR_VERIFIER_ACCOUNT_ID=verifier.proofpay.testnet
NEAR_VERIFIER_PUBLIC_KEY=
# Restricted record_attestation-only agent key; never use Full-Access here.
NEAR_VERIFIER_PRIVATE_KEY=
# Generated private key is stored at this ignored path with owner-only permissions.
NEAR_VERIFIER_KEY_FILE=.secrets/verifier-function-call-key.json
# 0.25 NEAR gas allowance; this does not permit attached deposits.
NEAR_VERIFIER_KEY_ALLOWANCE_YOCTO=250000000000000000000000
# Put the temporary Full-Access provisioning key only in ignored .env.provisioner.
# The key manager reads it only for `key:provision`; the verifier service does not load it.
