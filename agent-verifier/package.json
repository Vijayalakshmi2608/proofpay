{
  "name": "@proofpay/agent-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "key:generate": "tsx src/keyManager.ts generate",
    "key:provision": "tsx src/keyManager.ts provision",
    "verify:key-permissions": "tsx src/verifyKeyPermissions.ts"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "near-api-js": "7.4.0",
    "openai": "4.77.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
