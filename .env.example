# ── Frontend (browser-safe; never place secrets in NEXT_PUBLIC_ values) ─────
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_CONTRACT_ID=proofpay.testnet
# Optional public NEP-141 token account; set only for a token on the selected network
# and after the escrow owner has allowlisted it with set_ft_token_allowed.
NEXT_PUBLIC_NEAR_USDC_CONTRACT=
NEXT_PUBLIC_DEMO_MODE=true

# ── Frontend server -> verifier service (server-only; same-origin browser API) ─
VERIFIER_API_BASE_URL=http://127.0.0.1:4000

# ── Agent verifier service ─────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# In production set this to the exact browser origin, e.g. https://proofpay.example.
CORS_ORIGIN=http://localhost:3000
VERIFIER_MODE=heuristic
# Required only when VERIFIER_MODE=openai. Keep the provider key on the verifier only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ATTESTATION_MIN_CONFIDENCE=0.72
MAX_DELIVERABLE_CHARS=20000
GITHUB_TOKEN=
# Optional Ed25519 PEM; blank uses a per-process mock-TEE key, not hardware attestation.
TEE_SIGNING_PRIVATE_KEY_PEM=
# On-chain writes remain disabled unless explicitly enabled; token is required when enabled.
ATTESTOR_ALLOW_ONCHAIN_WRITES=false
ATTESTOR_API_TOKEN=
ATTESTOR_MAX_BUDGET_YOCTO=0

# NEAR Intents / 1Click. Dry quotes are default; fundable quotes require separate production opt-in.
NEAR_INTENTS_API_KEY=
NEAR_INTENTS_REFUND_ADDRESS=proofpay.near
INTENTS_ALLOW_FUNDABLE_QUOTES=false
INTENTS_SLIPPAGE_BPS=100

# ── NEAR contract deployment / verifier signer ──────────────────────────────
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ACCOUNT_ID=proofpay.testnet
NEAR_VERIFIER_ACCOUNT_ID=verifier.proofpay.testnet
# Public half of the dedicated Function-Call key restricted to the escrow contract
# and record_attestation; NEAR's key protocol prohibits attached deposits.
NEAR_VERIFIER_PUBLIC_KEY=
# Generated verifier key path; private material is stored only under the verifier workspace.
NEAR_VERIFIER_KEY_FILE=.secrets/verifier-function-call-key.json
# Function-Call key gas allowance, in yoctoNEAR (0.25 NEAR by default).
NEAR_VERIFIER_KEY_ALLOWANCE_YOCTO=250000000000000000000000
# Optional path to a testnet key file for near-cli-rs deployments.
NEAR_SIGNER_KEY_PATH=

# ── Cross-chain payout adapter (demo placeholders; configure per bridge) ────
PAYOUT_ADAPTER_MODE=mock
PAYOUT_WEBHOOK_SECRET=
EVM_RPC_URL=
EVM_PAYOUT_ROUTER_ADDRESS=

# ── Demo integration checks ────────────────────────────────────────────────
DEMO_FRONTEND_URL=http://localhost:3000
DEMO_VERIFIER_URL=http://localhost:4000
